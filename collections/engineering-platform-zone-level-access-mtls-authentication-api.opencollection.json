{
  "opencollection": "1.0.0",
  "info": {
    "name": "APIs.io Engineering Platform Amazon API Gateway 2014 11 13 Zone-Level Access mTLS Authentication API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Zone-Level Access mTLS Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "APIs.io Engineering Platform List mTLS certificates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://apigateway.{region}.amazonaws.com/zones/:zone_id/access/certificates",
            "params": [
              {
                "name": "zone_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Lists all mTLS certificates."
        }
      ]
    }
  ],
  "bundled": true
