        },
        {
          "info": {
            "name": "APIs.io Engineering Platform Update a Turnstile Widget",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://apigateway.{region}.amazonaws.com/accounts/:account_id/challenges/widgets/:sitekey",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "sitekey",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the configuration of a widget."
        },
        {
          "info": {
            "name": "APIs.io Engineering Platform Delete a Turnstile Widget",
            "type": "http"
          },
          "http": {
