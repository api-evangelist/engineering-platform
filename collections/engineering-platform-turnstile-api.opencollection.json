              },
              {
                "name": "direction",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Lists all turnstile widgets of an account."
        },
        {
          "info": {
            "name": "APIs.io Engineering Platform Create a Turnstile Widget",
            "type": "http"
