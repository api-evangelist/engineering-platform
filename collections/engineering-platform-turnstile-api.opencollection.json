        {
          "info": {
            "name": "APIs.io Engineering Platform Turnstile Widget Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://apigateway.{region}.amazonaws.com/accounts/:account_id/challenges/widgets/:sitekey",
            "params": [
              {
                "name": "account_id",
                "value": "",
