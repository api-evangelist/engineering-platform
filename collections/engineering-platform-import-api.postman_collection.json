  "item": [
    {
      "id": "3752858f-71b8-460e-bc83-ce9ecf826fed",
      "name": "Import",
      "description": {
        "content": "The **Import** endpoints enable you to manage [importing and exporting](https://learning.postman.com/docs/getting-started/importing-and-exporting-data/) Postman data.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a3e7b020-1b7d-407f-becb-3d6472596ae6",
          "name": "APIs.io Engineering Platform Import an OpenAPI definition",
          "request": {
            "name": "APIs.io Engineering Platform Import an OpenAPI definition",
            "description": {
              "content": "Imports an OpenAPI definition into Postman as a new [Postman Collection](https://learning.postman.com/docs/getting-started/creating-the-first-collection/).\n\n**Note:**\n\nThe Postman web app does not support the `file` input method type.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "import",
                "openapi"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "workspace",
                  "value": "<string>",
                  "description": "The workspace's ID."
                }
              ],
              "variable": [
                {
                  "description": "The AWS region (This can only be one of us-east-1,us-east-2,us-west-1,us-west-2,us-gov-west-1,us-gov-east-1,ca-central-1,eu-north-1,eu-west-1,eu-west-2,eu-west-3,eu-central-1,eu-south-1,af-south-1,ap-northeast-1,ap-northeast-2,ap-northeast-3,ap-southeast-1,ap-southeast-2,ap-east-1,ap-south-1,sa-east-1,me-south-1)",
                  "type": "any",
                  "value": "{{region}}",
                  "key": "region"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "type",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) The `file` type value. (This can only be one of file)"
                },
                {
                  "key": "input",
                  "type": "file",
                  "description": "(Required) A .zip file containing the definition file."
                }
              ]
            }
          },
          "response": [
            {
              "id": "d112e22d-ec02-4cc9-94f6-9d44ac855f7a",
              "name": "Successful Response",
