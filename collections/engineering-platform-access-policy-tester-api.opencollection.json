              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Starts an Access policy test."
        },
        {
          "info": {
            "name": "APIs.io Engineering Platform Get the current status of a given Access policy test",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://apigateway.{region}.amazonaws.com/accounts/:account_id/access/policy-tests/:policy_test_id",
