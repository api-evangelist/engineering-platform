                "name": "policy_test_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Fetches the current status of a given Access policy test."
        },
        {
          "info": {
            "name": "APIs.io Engineering Platform Get an Access policy test users page",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://apigateway.{region}.amazonaws.com/accounts/:account_id/access/policy-tests/:policy_test_id/users",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "policy_test_id",
                "value": "",
                "type": "path"
              }
            ]
