              }
            ]
          },
          "docs": "List all accounts you have ownership or verified access to."
        },
        {
          "info": {
            "name": "APIs.io Engineering Platform Create an account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://apigateway.{region}.amazonaws.com/accounts",
