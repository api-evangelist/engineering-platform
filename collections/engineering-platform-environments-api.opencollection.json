        },
        {
          "info": {
            "name": "APIs.io Engineering Platform Merge a fork",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://apigateway.{region}.amazonaws.com/environments/:environmentId/merges",
