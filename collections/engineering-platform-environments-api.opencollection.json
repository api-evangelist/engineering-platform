            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://apigateway.{region}.amazonaws.com/environments",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "query",
                "description": "The workspace's ID."
              }
            ]
          },
          "docs": "Gets information about all of your [environments](https://learning.postman.com/docs/sending-requests/managing-environments/)."
        },
        {
          "info": {
            "name": "APIs.io Engineering Platform Create an environment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://apigateway.{region}.amazonaws.com/environments",
            "params": [
