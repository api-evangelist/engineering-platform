            "name": "APIs.io Engineering Platform Update custom profile",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://apigateway.{region}.amazonaws.com/accounts/:account_id/dlp/profiles/custom/:profile_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "profile_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a DLP custom profile."
        },
        {
          "info": {
            "name": "APIs.io Engineering Platform Delete custom profile",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://apigateway.{region}.amazonaws.com/accounts/:account_id/dlp/profiles/custom/:profile_id",
            "params": [
