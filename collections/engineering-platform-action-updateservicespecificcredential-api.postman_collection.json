          "id": "7657b3e6-bc9f-41ef-8509-5395c58138f0",
          "name": "GET Update Service Specific Credential",
          "request": {
            "name": "GET Update Service Specific Credential",
            "description": {
              "content": "Sets the status of a service-specific credential to <code>Active</code> or <code>Inactive</code>. Service-specific credentials that are inactive cannot be used for authentication to the service. This operation can be used to disable a user's service-specific credential as part of a credential rotation work flow.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "hash": "Action=UpdateServiceSpecificCredential",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "UserName",
                  "value": "<string>",
                  "description": "<p>The name of the IAM user associated with the service-specific credential. If you do not specify this value, then the operation assumes the user whose credentials are used to call the operation.</p> <p>This parameter allows (through its <a href=\"http://wikipedia.org/wiki/regex\">regex pattern</a>) a string of characters consisting of upper and lowercase alphanumeric characters with no spaces. You can also include any of the following characters: _+=,.@-</p>"
                },
                {
                  "disabled": false,
                  "key": "ServiceSpecificCredentialId",
                  "value": "<string>",
                  "description": "(Required) <p>The unique identifier of the service-specific credential.</p> <p>This parameter allows (through its <a href=\"http://wikipedia.org/wiki/regex\">regex pattern</a>) a string of characters that can consist of any upper or lowercased letter or digit.</p>"
                },
                {
                  "disabled": false,
                  "key": "Status",
                  "value": "<string>",
                  "description": "(Required) The status to be assigned to the service-specific credential."
                },
                {
                  "disabled": false,
