{
  "opencollection": "1.0.0",
  "info": {
    "name": "APIs.io Engineering Platform Amazon API Gateway 2014 11 13 User API Tokens API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "User API Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "APIs.io Engineering Platform List Tokens",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://apigateway.{region}.amazonaws.com/user/tokens",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query"
              },
              {
                "name": "direction",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List all access tokens you created."
        },
        {
          "info": {
            "name": "APIs.io Engineering Platform Create Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://apigateway.{region}.amazonaws.com/user/tokens",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new access token."
        },
        {
          "info": {
            "name": "APIs.io Engineering Platform Token Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://apigateway.{region}.amazonaws.com/user/tokens/:token_id",
            "params": [
              {
                "name": "token_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get information about a specific token."
        },
        {
          "info": {
            "name": "APIs.io Engineering Platform Update Token",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://apigateway.{region}.amazonaws.com/user/tokens/:token_id",
            "params": [
              {
                "name": "token_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing token."
        },
        {
          "info": {
            "name": "APIs.io Engineering Platform Delete Token",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://apigateway.{region}.amazonaws.com/user/tokens/:token_id",
            "params": [
              {
                "name": "token_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Destroy a token."
        },
        {
          "info": {
            "name": "APIs.io Engineering Platform Roll Token",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://apigateway.{region}.amazonaws.com/user/tokens/:token_id/value",
            "params": [
              {
                "name": "token_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Roll the token secret."
        },
        {
          "info": {
            "name": "APIs.io Engineering Platform Verify Token",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://apigateway.{region}.amazonaws.com/user/tokens/verify"
          },
          "docs": "Test whether a token works."
        }
      ]
    }
  ],
  "bundled": true
}