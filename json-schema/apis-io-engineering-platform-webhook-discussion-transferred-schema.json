{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/webhook-discussion-transferred",
  "title": "discussion transferred event",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
