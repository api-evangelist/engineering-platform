{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/maintenance-status",
  "title": "maintenance-status",
  "type": "object",
  "properties": {
    "status": {
      "type": "string"
    },
    "scheduled_time": {
      "type": "string"
    },
    "connection_services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "number": {
            "type": "integer"
          }
        },
        "required": [
          "name",
          "number"
        ]
      }
    }
  }
}