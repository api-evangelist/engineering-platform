{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/apiSchema400ErrorNotLinked",
  "title": "Schema Not Linked to API",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "description": "The error type.",
      "example": "invalidParamError"
    },
    "title": {
      "type": "string",
