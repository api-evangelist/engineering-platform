{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/webhook-repository-renamed",
  "title": "repository renamed event",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "renamed"
      ]
    },
    "changes": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "object",
          "properties": {
            "name": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                }
              },
              "required": [
                "from"
              ]
            }
          },
          "required": [
            "name"
          ]
        }
      },
      "required": [
        "repository"
      ]
    },
    "enterprise": {
      "$ref": "#/components/schemas/enterprise-webhooks"
    },
    "installation": {
      "$ref": "#/components/schemas/simple-installation"
    },
    "organization": {
      "$ref": "#/components/schemas/organization-simple-webhooks"
    },
    "repository": {
      "$ref": "#/components/schemas/repository-webhooks"
    },
    "sender": {
      "$ref": "#/components/schemas/simple-user-webhooks"
    }
  },
  "required": [
    "action",
    "changes",
    "repository",
    "sender"
  ]
}