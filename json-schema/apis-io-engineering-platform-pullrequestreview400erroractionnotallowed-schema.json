{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/pullRequestReview400ErrorActionNotAllowed",
  "title": "Action Not Allowed",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "format": "uri",
      "description": "The error type.",
      "example": "https://api.postman.com/problems/bad-request"
    },
    "title": {
      "type": "string",
      "description": "A short summary of the error.",
      "example": "Bad Request"
    },
    "detail": {
      "type": "string",
      "description": "Details about the occurrence of the error.",
      "example": "Given action on current pull request is not allowed"
    },
    "status": {
      "type": "number",
      "format": "http-status-code",
      "description": "The error's HTTP status code.",
      "example": 400
    }
  }
}