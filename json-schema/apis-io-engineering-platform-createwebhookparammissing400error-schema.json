{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/createWebhookParamMissing400Error",
  "title": "createWebhookParamMissing400Error",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The error name.",
          "example": "paramMissingError"
        },
        "message": {
          "type": "string",
          "description": "The error message.",
          "example": "Parameter is missing in the request."
        },
        "details": {
          "type": "object",
          "description": "Information about the error.",
          "properties": {
            "param": {
              "type": "array",
              "description": "Information about the missing parameter.",
              "items": {
                "type": "string"
              },
              "example": [
                "collection"
              ]
            }
          }
        }
      }
    }
  }
}