{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/iam_user_invite",
  "title": "iam_user_invite",
  "allOf": [
    {
      "$ref": "#/components/schemas/iam_base"
    },
    {
      "properties": {
        "status": {
          "description": "Current status of the invitation.",
          "enum": [
