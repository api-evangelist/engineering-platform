{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/access_azure_group_rule",
  "title": "Azure group",
  "description": "Matches an Azure group.\nRequires an Azure identity provider.",
  "properties": {
    "azureAD": {
      "properties": {
        "id": {
          "description": "The ID of an Azure group.",
          "example": "aa0a4aab-672b-4bdb-bc33-a59f1130a11f",
          "type": "string"
        },
        "identity_provider_id": {
          "description": "The ID of your Azure identity provider.",
          "example": "ea85612a-29c8-46c2-bacb-669d65136971",
          "type": "string"
        }
      },
      "required": [
        "id",
        "identity_provider_id"
      ],
      "type": "object"
    }
  },
  "required": [
    "azureAD"
  ],
  "type": "object"
}