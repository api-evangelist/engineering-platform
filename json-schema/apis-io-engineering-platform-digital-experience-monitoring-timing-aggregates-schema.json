{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/digital-experience-monitoring_timing_aggregates",
  "title": "digital-experience-monitoring_timing_aggregates",
  "properties": {
    "avgMs": {
      "nullable": true,
      "type": "integer"
    },
    "history": {
      "items": {
        "$ref": "#/components/schemas/digital-experience-monitoring_aggregate_stat"
      },
      "type": "array"
    },
    "overTime": {
      "nullable": true,
      "properties": {
        "timePeriod": {
          "$ref": "#/components/schemas/digital-experience-monitoring_aggregate_time_period"
        },
        "values": {
          "items": {
            "$ref": "#/components/schemas/digital-experience-monitoring_aggregate_time_slot"
          },
          "type": "array"
        }
      },
      "required": [
        "values",
        "timePeriod"
      ],
      "type": "object"
    }
  },
  "required": [
    "history"
  ],
  "type": "object"
}