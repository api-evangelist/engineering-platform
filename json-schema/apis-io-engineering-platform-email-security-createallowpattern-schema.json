      "type": "boolean"
    },
    "is_regex": {
      "type": "boolean"
    },
    "is_sender": {
      "type": "boolean"
    },
    "is_spoof": {
      "type": "boolean"
    },
    "pattern": {
      "minLength": 1,
      "type": "string"
    },
    "pattern_type": {
