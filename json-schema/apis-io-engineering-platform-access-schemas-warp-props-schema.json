{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/access_schemas-warp_props",
  "title": "access_schemas-warp_props",
  "allOf": [
    {
      "$ref": "#/components/schemas/access_schemas-feature_app_props"
    },
    {
      "properties": {
        "domain": {
          "example": "authdomain.cloudflareaccess.com/warp",
          "readOnly": true
        },
        "name": {
          "default": "Warp Login App",
          "example": "Warp Login App",
          "readOnly": true
        },
        "type": {
          "description": "The application type.",
          "example": "warp",
          "type": "string"
        }
      }
    }
  ]
}