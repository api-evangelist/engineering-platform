{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/DeleteUserPermissionsBoundaryRequest",
  "title": "DeleteUserPermissionsBoundaryRequest",
  "type": "object",
  "required": [
    "UserName"
  ],
  "properties": {
    "UserName": {
      "allOf": [
        {
          "$ref": "#/components/schemas/userNameType"
