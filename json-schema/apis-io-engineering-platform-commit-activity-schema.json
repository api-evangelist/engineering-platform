{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/commit-activity",
  "title": "Commit Activity",
  "description": "Commit Activity",
  "type": "object",
  "properties": {
    "days": {
      "type": "array",
      "example": [
        0,
        3,
        26,
        20,
        39,
        1,
        0
      ],
      "items": {
        "type": "integer"
      }
    },
    "total": {
      "type": "integer",
      "example": 89
    },
    "week": {
      "type": "integer",
      "example": 1336280400
    }
  },
  "required": [
    "days",
    "total",
    "week"
  ]
}