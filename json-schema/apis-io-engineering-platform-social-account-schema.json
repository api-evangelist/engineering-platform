{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/social-account",
  "title": "Social account",
  "description": "Social media account",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "example": "linkedin"
    },
    "url": {
      "type": "string",
      "example": "https://www.linkedin.com/company/github/"
    }
  },
  "required": [
    "provider",
    "url"
  ]
}