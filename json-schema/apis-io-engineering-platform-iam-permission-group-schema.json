{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/iam_permission_group",
  "title": "iam_permission_group",
  "description": "A named group of permissions that map to a group of operations against resources.",
  "properties": {
    "id": {
      "description": "Identifier of the group.",
      "example": "6d7f2f5f5b1d4a0e9081fdc98d432fd1",
      "readOnly": true,
      "type": "string"
    },
    "meta": {
      "description": "Attributes associated to the permission group.",
      "example": {
        "label": "load_balancer_admin",
        "scopes": "com.cloudflare.api.account"
      },
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": {
      "description": "Name of the group.",
      "example": "Load Balancer",
      "readOnly": true,
      "type": "string"
    }
  },
  "required": [
    "id"
  ],
  "type": "object"
}