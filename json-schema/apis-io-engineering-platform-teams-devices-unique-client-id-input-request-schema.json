{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/teams-devices_unique_client_id_input_request",
  "title": "Unique Client ID",
  "properties": {
    "id": {
      "description": "List ID.",
      "example": "da3de859-8f6e-47ea-a2b5-b2433858471f",
      "type": "string"
    },
    "operating_system": {
      "description": "Operating System",
      "enum": [
        "android",
        "ios",
        "chromeos"
      ],
      "example": "android",
      "type": "string"
    }
  },
  "required": [
    "operating_system",
    "id"
  ],
  "type": "object"
}