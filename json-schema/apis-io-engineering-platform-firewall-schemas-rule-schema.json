{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/firewall_schemas-rule",
  "title": "firewall_schemas-rule",
  "allOf": [
    {
      "$ref": "#/components/schemas/firewall_rule"
    },
    {
      "properties": {
        "scope": {
          "description": "All zones owned by the user will have the rule applied.",
          "properties": {
            "email": {
              "$ref": "#/components/schemas/firewall_email"
            },
            "id": {
              "$ref": "#/components/schemas/firewall_identifier"
            },
            "type": {
              "description": "The scope of the rule.",
              "enum": [
                "user",
                "organization"
              ],
              "example": "user",
              "readOnly": true
            }
          },
          "readOnly": true,
          "type": "object"
        }
      }
    }
  ],
  "required": [
    "id",
    "mode",
    "allowed_modes",
    "configuration",
    "scope"
  ],
  "type": "object"
}