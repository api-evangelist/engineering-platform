{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/zaraz_click-listener-rule",
  "title": "zaraz_click-listener-rule",
  "properties": {
    "action": {
      "enum": [
        "clickListener"
      ],
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "settings": {
      "properties": {
        "selector": {
          "type": "string"
        },
        "type": {
          "enum": [
            "xpath",
            "css"
          ],
          "type": "string"
        },
        "waitForTags": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "type",
        "selector",
        "waitForTags"
      ],
      "type": "object"
    }
  },
  "required": [
    "id",
    "action",
    "settings"
  ],
  "type": "object"
}