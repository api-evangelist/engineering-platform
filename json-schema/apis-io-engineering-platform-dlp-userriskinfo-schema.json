{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/dlp_UserRiskInfo",
  "title": "dlp_UserRiskInfo",
  "properties": {
    "email": {
      "type": "string"
    },
    "event_count": {
      "minimum": 0,
      "type": "integer"
    },
    "last_event": {
      "format": "date-time",
      "type": "string"
    },
    "max_risk_level": {
      "$ref": "#/components/schemas/dlp_RiskLevel"
    },
    "name": {
      "type": "string"
    },
    "user_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "name",
    "email",
    "max_risk_level",
    "event_count",
    "last_event"
  ],
  "type": "object"
}