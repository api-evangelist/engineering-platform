{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/dns-analytics_report",
  "title": "dns-analytics_report",
  "allOf": [
    {
      "$ref": "#/components/schemas/dns-analytics_result"
    },
    {
      "properties": {
        "data": {
          "items": {
            "properties": {
              "metrics": {
                "description": "Array with one item per requested metric. Each item is a single value.",
                "items": {
                  "description": "Nominal metric value.",
                  "type": "number"
                },
                "type": "array"
              }
            },
            "required": [
              "metrics"
            ]
          }
        }
      },
      "required": [
        "data"
      ]
    }
  ]
}