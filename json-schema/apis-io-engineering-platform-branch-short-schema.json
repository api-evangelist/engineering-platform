{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/branch-short",
  "title": "Branch Short",
  "description": "Branch Short",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "commit": {
      "type": "object",
      "properties": {
        "sha": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "sha",
        "url"
      ]
    },
    "protected": {
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "commit",
    "protected"
  ]
}