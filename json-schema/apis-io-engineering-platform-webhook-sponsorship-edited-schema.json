{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/webhook-sponsorship-edited",
  "title": "sponsorship edited event",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "edited"
      ]
    },
    "changes": {
      "type": "object",
      "properties": {
        "privacy_level": {
          "type": "object",
