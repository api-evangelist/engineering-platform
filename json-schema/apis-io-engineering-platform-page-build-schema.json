{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/page-build",
  "title": "Page Build",
  "description": "Page Build",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "format": "uri"
    },
    "status": {
      "type": "string"
    },
    "error": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "nullable": true
        }
      },
      "required": [
        "message"
      ]
    },
    "pusher": {
      "$ref": "#/components/schemas/nullable-simple-user"
    },
    "commit": {
      "type": "string"
    },
    "duration": {
      "type": "integer"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "url",
    "status",
    "error",
    "pusher",
    "commit",
    "duration",
    "created_at",
    "updated_at"
  ]
}