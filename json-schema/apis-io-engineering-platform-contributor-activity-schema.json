{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/contributor-activity",
  "title": "Contributor Activity",
  "description": "Contributor Activity",
  "type": "object",
  "properties": {
    "author": {
      "$ref": "#/components/schemas/nullable-simple-user"
    },
    "total": {
      "type": "integer",
      "example": 135
    },
    "weeks": {
      "type": "array",
      "example": [
        {
          "w": "1367712000",
          "a": 6898,
          "d": 77,
          "c": 10
        }
      ],
      "items": {
        "type": "object",
        "properties": {
          "w": {
            "type": "integer"
          },
          "a": {
            "type": "integer"
          },
          "d": {
            "type": "integer"
          },
          "c": {
            "type": "integer"
          }
        }
      }
    }
  },
  "required": [
    "author",
    "total",
    "weeks"
  ]
}