{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/installation-token",
  "title": "Installation Token",
  "description": "Authentication token for a GitHub App installed on a user or org.",
  "type": "object",
  "properties": {
    "token": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "permissions": {
      "$ref": "#/components/schemas/app-permissions"
    },
    "repository_selection": {
      "type": "string",
      "enum": [
        "all",
        "selected"
      ]
    },
    "repositories": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/repository"
      }
    },
    "single_file": {
      "type": "string",
      "example": "README.md"
    },
    "has_multiple_single_files": {
      "type": "boolean",
      "example": true
    },
    "single_file_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "example": [
        "config.yml",
        ".github/issue_TEMPLATE.md"
      ]
    }
  },
  "required": [
    "token",
    "expires_at"
  ]
}