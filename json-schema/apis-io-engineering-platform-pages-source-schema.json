{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/pages_source",
  "title": "pages_source",
  "properties": {
    "config": {
      "properties": {
        "deployments_enabled": {
          "type": "boolean"
        },
        "owner": {
          "type": "string"
        },
        "path_excludes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "path_includes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pr_comments_enabled": {
          "type": "boolean"
        },
        "preview_branch_excludes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "preview_branch_includes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "preview_deployment_setting": {
          "enum": [
            "all",
            "none",
            "custom"
          ],
          "type": "string"
        },
        "production_branch": {
          "type": "string"
        },
        "production_deployments_enabled": {
          "type": "boolean"
        },
        "repo_name": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "type": {
      "type": "string"
    }
  },
  "readOnly": true,
  "type": "object"
}