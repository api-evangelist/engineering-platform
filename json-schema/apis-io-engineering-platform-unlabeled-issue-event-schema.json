{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/unlabeled-issue-event",
  "title": "Unlabeled Issue Event",
  "description": "Unlabeled Issue Event",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "node_id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "actor": {
      "$ref": "#/components/schemas/simple-user"
    },
    "event": {
      "type": "string"
    },
    "commit_id": {
      "type": "string",
      "nullable": true
    },
    "commit_url": {
      "type": "string",
      "nullable": true
    },
    "created_at": {
      "type": "string"
    },
    "performed_via_github_app": {
      "$ref": "#/components/schemas/nullable-integration"
    },
    "label": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "color"
      ]
    }
  },
  "required": [
    "label",
    "id",
    "node_id",
    "url",
    "actor",
    "event",
    "commit_id",
    "commit_url",
    "created_at",
    "performed_via_github_app"
  ]
}