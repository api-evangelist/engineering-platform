{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/email",
  "title": "Email",
  "description": "Email",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "example": "octocat@github.com"
    },
    "primary": {
      "type": "boolean",
      "example": true
    },
    "verified": {
      "type": "boolean",
      "example": true
    },
    "visibility": {
      "type": "string",
      "example": "public",
      "nullable": true
    }
  },
  "required": [
    "email",
    "primary",
    "verified",
    "visibility"
  ]
}