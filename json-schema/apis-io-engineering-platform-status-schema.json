{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/status",
  "title": "Status",
  "description": "The status of a commit.",
  "type": "object",
  "properties": {
    "url": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string",
      "nullable": true
    },
    "id": {
      "type": "integer"
    },
    "node_id": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "nullable": true
    },
    "target_url": {
      "type": "string",
      "nullable": true
    },
    "context": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "creator": {
      "$ref": "#/components/schemas/nullable-simple-user"
    }
  },
  "required": [
    "url",
    "avatar_url",
    "id",
    "node_id",
    "state",
    "description",
    "target_url",
    "context",
    "created_at",
    "updated_at",
    "creator"
  ]
}