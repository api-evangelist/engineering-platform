{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/VideoObject",
  "title": "VideoObject",
  "properties": {
    "allowHttpsEmbed": {
      "type": "boolean",
      "readOnly": true
    },
    "allowMobileEmbed": {
      "type": "boolean",
      "readOnly": true
    },
    "embedHtml": {
      "type": "string",
      "readOnly": true
    },
    "isSuperfresh": {
      "type": "boolean",
      "readOnly": true
    },
    "motionThumbnailId": {
      "type": "string",
      "readOnly": true
    },
    "motionThumbnailUrl": {
      "type": "string",
      "readOnly": true
    },
    "thumbnail": {
      "$ref": "#/components/schemas/ImageObject"
    },
    "videoId": {
      "type": "string",
      "readOnly": true
    },
    "viewCount": {
      "type": "integer",
      "format": "int32",
      "readOnly": true
    }
  },
  "description": "Defines a video object that is relevant to the query.",
  "allOf": [
    {
      "$ref": "#/components/schemas/MediaObject"
    }
  ]
}