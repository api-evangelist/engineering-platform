{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/dlp_CustomEntry",
  "title": "dlp_CustomEntry",
  "properties": {
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "id": {
      "format": "uuid",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "pattern": {
      "$ref": "#/components/schemas/dlp_Pattern"
    },
    "profile_id": {
      "format": "uuid",
      "nullable": true,
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "created_at",
    "updated_at",
    "pattern",
    "enabled"
  ],
  "type": "object"
}